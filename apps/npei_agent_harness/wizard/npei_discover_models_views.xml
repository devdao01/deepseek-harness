<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_discover_models_form" model="ir.ui.view">
        <field name="name">npei.agent.discover.models.form</field>
        <field name="model">npei.agent.discover.models</field>
        <field name="arch" type="xml">
            <form string="Discover Models">
                <sheet>
                    <group>
                        <group>
                            <field name="settings_ns"/>
                            <field name="provider"/>
                        </group>
                        <group>
                            <field name="base_url"/>
                            <field name="api_type"/>
                            <field name="api_key" password="True"/>
                        </group>
                    </group>
                    <group string="Discovered Models">
                        <field name="result_text" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_discover" type="object"
                            string="Discover" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_npei_discover_models" model="ir.actions.act_window">
        <field name="name">Discover Models</field>
        <field name="res_model">npei.agent.discover.models</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
