<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_discover_models_form" model="ir.ui.view">
        <field name="name">npei.agent.discover.models.form</field>
        <field name="model">npei.agent.discover.models</field>
        <field name="arch" type="xml">
            <form string="Khám phá Mô hình">
                <sheet>
                    <group>
                        <group>
                            <field name="settings_ns"/>
                            <field name="provider"/>
                        </group>
                        <group>
                            <field name="base_url"/>
                            <field name="api_type"/>
                            <field name="api_key" password="True"/>
                        </group>
                    </group>
                    <group string="Mô hình đã khám phá">
                        <field name="result_json" invisible="1"/>
                        <field name="result_text" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Nhận vào">
                        <field name="target_provider_id" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_discover" type="object"
                            string="Khám phá" class="btn-primary"/>
                    <button name="action_adopt" type="object"
                            string="Nhận vào Nhà cung cấp"
                            invisible="not result_json or not target_provider_id"/>
                    <button string="Đóng" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_npei_discover_models" model="ir.actions.act_window">
        <field name="name">Khám phá Mô hình</field>
        <field name="res_model">npei.agent.discover.models</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
