<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_model_tree" model="ir.ui.view">
        <field name="name">npei.agent.model.tree</field>
        <field name="model">npei.agent.model</field>
        <field name="arch" type="xml">
            <tree string="Models">
                <field name="provider"/>
                <field name="model_id"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_model_form" model="ir.ui.view">
        <field name="name">npei.agent.model.form</field>
        <field name="model">npei.agent.model</field>
        <field name="arch" type="xml">
            <form string="Model">
                <header>
                    <button name="action_sync_from_harness" type="object"
                            string="Sync from Harness" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="provider" readonly="1"/>
                            <field name="model_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_npei_agent_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">npei.agent.model</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Server action so the sync can run from a menu when the list is empty. -->
    <record id="action_npei_sync_models" model="ir.actions.server">
        <field name="name">Sync Models from Harness</field>
        <field name="model_id" ref="model_npei_agent_model"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>
</odoo>
