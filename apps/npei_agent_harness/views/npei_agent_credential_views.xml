<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_credential_tree" model="ir.ui.view">
        <field name="name">npei.agent.credential.tree</field>
        <field name="model">npei.agent.credential</field>
        <field name="arch" type="xml">
            <tree string="Credentials">
                <field name="seq" widget='handle'/>
                <field name="seq" optional="show"/>
                <field name="id" optional="show"/>
                <field name="ref"/>
                <field name="configured"/>
                <field name="source"/>
                <field name="writable"/>
                <field name="uuid" optional="show"/>
                <field name="is_locked" optional="show"/>
                <field name="active" optional="show"/>
                <field name="create_uid" optional="show"/>
                <field name="write_uid" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="write_date" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_credential_form" model="ir.ui.view">
        <field name="name">npei.agent.credential.form</field>
        <field name="model">npei.agent.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <header>
                    <button name="action_unset" type="object"
                            string="Unset"
                            confirm="Remove this credential's value on the harness?"/>
                    <button name="action_sync_from_harness" type="object"
                            string="Sync from Harness"/>
                    <button name="act_lock" string="Khóa" type="object" groups="npei_base.npei_group_lock" invisible="is_locked"/>
                    <button name="act_unlock" string="Mở Khóa" type="object" groups="npei_base.npei_group_lock" invisible="not is_locked"/>
                </header>
                <sheet>
                    <div class="alert alert-success text-center o_form_header" role="alert" invisible="not is_locked"><div><strong>ĐÃ KHOÁ</strong></div></div>
                    <group>
                        <group>
                            <field name="ref" readonly="id != False or is_locked"
                                   placeholder="e.g. DEEPSEEK_API_KEY"/>
                            <field name="configured" readonly="1"/>
                        </group>
                        <group>
                            <field name="source" readonly="1"/>
                            <field name="writable" readonly="1"/>
                        </group>
                    </group>
                    <group string="Set a new value">
                        <field name="value" password="True" readonly="is_locked"
                               placeholder="Write-only; pushed to the harness on Save"/>
                    </group>
                    <notebook>
                        <page string="Quản lý Hệ thống*">
                            <notebook>
                                <page string="Cấu hình Hệ thống*">
                                    <notebook>
                                        <page string="Khởi tạo*">
                                            <group>
                                                <group>
                                                    <field name="create_uid" string="Người dùng Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_uid" string="Người dùng Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                    <field name="create_date" string="Thời gian Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_date" string="Thời gian Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="active" widget="boolean_toggle" readonly="is_locked"/>
                                                    <field name="is_locked" readonly="1"/>
                                                    <field name="id" readonly="1"/>
                                                    <field name="uuid" readonly="is_locked"/>
                                                    <field name="seq" readonly="is_locked"/>
                                                </group>
                                            </group>
                                        </page>
                                    </notebook>
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_npei_agent_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">npei.agent.credential</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Server action so the sync can run from a menu when the list is empty. -->
    <record id="action_npei_sync_credentials" model="ir.actions.server">
        <field name="name">Sync Credentials from Harness</field>
        <field name="model_id" ref="model_npei_agent_credential"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>
</odoo>
