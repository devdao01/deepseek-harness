<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_npei" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.npei_agent_harness</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="MTIL Agent" string="MTIL Agent" name="npei_agent_harness">
                    <block title="Kết nối Harness"
                           name="npei_harness_connection">
                        <setting string="URL Cơ sở"
                                 help="URL cơ sở của DeepSeek Harness. Gateway sẽ nối thêm /api/&lt;method&gt;.">
                            <field name="npei_harness_base_url"/>
                        </setting>
                        <setting string="Token API"
                                 help="Bearer token cho harness (~/.dsh/api-token trên máy chủ harness). Không bao giờ lộ ra trình duyệt.">
                            <field name="npei_harness_api_token" password="True"/>
                        </setting>
                        <setting string="Khóa bí mật Ticket"
                                 help="Khóa bí mật HMAC-SHA256 chung (>= 32 ký tự) mà Flask API của MTIL dùng để ký ticket theo người dùng; phải khớp với DSH_TICKET_SECRET của harness. Không bao giờ lộ ra trình duyệt.">
                            <field name="npei_harness_ticket_secret" password="True"/>
                        </setting>
                        <setting string="Kết nối"
                                 help="Ping harness (host.describe) bằng URL và token đã lưu.">
                            <button name="action_test_harness_connection"
                                    type="object"
                                    string="Kiểm tra kết nối"
                                    class="btn-secondary"/>
                        </setting>
                        <setting string="Xóa dữ liệu"
                                 groups="base.group_system"
                                 help="Xóa toàn bộ bản ghi MTIL Agent (phiên, preset, kỹ năng, thông tin xác thực, nhà cung cấp, mô hình, cài đặt), trừ các mẫu tuyến đã gieo. Không ảnh hưởng harness. Không thể hoàn tác.">
                            <button name="action_clear_data"
                                    type="object"
                                    string="Xóa dữ liệu"
                                    class="btn-danger"
                                    confirm="Thao tác này sẽ xóa vĩnh viễn toàn bộ dữ liệu MTIL Agent trong Odoo (trừ các mẫu tuyến đã gieo). Harness không bị ảnh hưởng. Tiếp tục?"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_npei_agent_config_settings" model="ir.actions.act_window">
        <field name="name">Cài đặt</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'npei_agent_harness'}</field>
    </record>
</odoo>
