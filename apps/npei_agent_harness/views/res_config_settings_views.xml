<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_npei" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.npei_agent_harness</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="MTIL Agent" string="MTIL Agent" name="npei_agent_harness">
                    <block title="Harness Connection"
                           name="npei_harness_connection">
                        <setting string="Base URL"
                                 help="Base URL of the DeepSeek Harness. The gateway appends /api/&lt;method&gt;.">
                            <field name="npei_harness_base_url"/>
                        </setting>
                        <setting string="API Token"
                                 help="Bearer token for the harness (~/.dsh/api-token on the harness host). Never exposed to the browser.">
                            <field name="npei_harness_api_token" password="True"/>
                        </setting>
                        <setting string="Ticket Secret"
                                 help="Shared HMAC-SHA256 secret (>= 32 chars) the MTIL Flask API signs per-user tickets with; must equal the harness DSH_TICKET_SECRET. Never exposed to the browser.">
                            <field name="npei_harness_ticket_secret" password="True"/>
                        </setting>
                        <setting string="Connection"
                                 help="Ping the harness (session/modelCatalog) with the saved URL and token.">
                            <button name="action_test_harness_connection"
                                    type="object"
                                    string="Test Connection"
                                    class="btn-secondary"/>
                        </setting>
                        <setting string="Clear Data"
                                 groups="base.group_system"
                                 help="Delete every MTIL Agent record (sessions, presets, skills, credentials, providers, models, settings) except the seeded provider route templates. Does not touch the harness. Irreversible.">
                            <button name="action_clear_data"
                                    type="object"
                                    string="Clear Data"
                                    class="btn-danger"
                                    confirm="This permanently deletes all MTIL Agent data in Odoo (except seeded route templates). The harness is not affected. Continue?"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_npei_agent_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'npei_agent_harness'}</field>
    </record>
</odoo>
