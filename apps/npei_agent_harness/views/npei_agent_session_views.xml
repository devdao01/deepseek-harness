<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_session_tree" model="ir.ui.view">
        <field name="name">npei.agent.session.tree</field>
        <field name="model">npei.agent.session</field>
        <field name="arch" type="xml">
            <tree string="Agent Sessions">
                <field name="session_id"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="preset_id"/>
                <field name="create_uid"/>
                <field name="write_date"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_session_form" model="ir.ui.view">
        <field name="name">npei.agent.session.form</field>
        <field name="model">npei.agent.session</field>
        <field name="arch" type="xml">
            <form string="Agent Session">
                <header>
                    <button name="action_push_access"
                            type="object"
                            string="Push Access to Harness"
                            class="btn-secondary"
                            help="Re-send the allowed-user set to the harness access store."/>
                </header>
                <sheet>
                    <group>
                        <field name="name" string="Title" placeholder="e.g. Hồ sơ khách hàng X"/>
                        <field name="preset_id"/>
                    </group>
                    <group string="Allowed Users">
                        <field name="user_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group string="Technical" col="2">
                        <!-- All auto-filled by the harness; shown read-only for
                             reference. session_id stays editable before the first
                             save only, to adopt an existing harness session. -->
                        <field name="session_id"
                               readonly="id != False"
                               placeholder="Leave blank — created on the harness on save"/>
                        <field name="workspace_path" readonly="1"
                               placeholder="Defaults from the chosen preset"/>
                        <field name="create_uid" readonly="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_npei_agent_session_search" model="ir.ui.view">
        <field name="name">npei.agent.session.search</field>
        <field name="model">npei.agent.session</field>
        <field name="arch" type="xml">
            <search string="Agent Sessions">
                <field name="session_id"/>
                <field name="name"/>
                <field name="create_uid"/>
                <field name="user_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Creator" name="group_creator" context="{'group_by': 'create_uid'}"/>
                    <filter string="Preset" name="group_preset" context="{'group_by': 'preset_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_npei_agent_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">npei.agent.session</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_npei_agent_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a harness session mapping</p>
            <p>Map a harness session id to the Odoo users allowed to drive it.</p>
        </field>
    </record>
</odoo>
