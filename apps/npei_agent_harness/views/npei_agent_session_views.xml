<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_session_tree" model="ir.ui.view">
        <field name="name">npei.agent.session.tree</field>
        <field name="model">npei.agent.session</field>
        <field name="arch" type="xml">
            <tree string="Agent Sessions">
                <field name="seq" widget='handle'/>
                <field name="seq" optional="show"/>
                <field name="id" optional="show"/>
                <field name="session_id"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="preset_id"/>
                <field name="running" optional="show"/>
                <field name="blank" optional="hide"/>
                <field name="harness_updated_at" optional="show"/>
                <field name="uuid" optional="show"/>
                <field name="is_locked" optional="show"/>
                <field name="active" optional="show"/>
                <field name="create_uid" optional="show"/>
                <field name="write_uid" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="write_date" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_session_form" model="ir.ui.view">
        <field name="name">npei.agent.session.form</field>
        <field name="model">npei.agent.session</field>
        <field name="arch" type="xml">
            <form string="Agent Session">
                <header>
                    <button name="act_lock" string="Khóa" type="object" groups="npei_base.npei_group_lock" invisible="is_locked"/>
                    <button name="act_unlock" string="Mở Khóa" type="object" groups="npei_base.npei_group_lock" invisible="not is_locked"/>
                </header>
                <sheet>
                    <div class="alert alert-success text-center o_form_header" role="alert" invisible="not is_locked"><div><strong>ĐÃ KHOÁ</strong></div></div>
                    <group>
                        <group>
                            <field name="name" string="Title"/>
                            <field name="preset_id" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="session_id" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"
                                   readonly="1"/>
                            <field name="workspace_path" readonly="1"
                                   placeholder="Defaults from the chosen preset"/>
                            <field name="running" readonly="1"/>
                            <field name="harness_updated_at" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allowed Users">
                            <field name="user_ids" options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                        </page>
                        <page string="Quản lý Hệ thống*">
                            <notebook>
                                <page string="Cấu hình Hệ thống*">
                                    <notebook>
                                        <page string="Khởi tạo*">
                                            <group>
                                                <group>
                                                    <field name="create_uid" string="Người dùng Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_uid" string="Người dùng Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                    <field name="create_date" string="Thời gian Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_date" string="Thời gian Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="active" widget="boolean_toggle" readonly="is_locked"/>
                                                    <field name="is_locked" readonly="1"/>
                                                    <field name="id" readonly="1"/>
                                                    <field name="uuid" readonly="is_locked"/>
                                                    <field name="seq" readonly="is_locked"/>
                                                </group>
                                            </group>
                                        </page>
                                    </notebook>
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_npei_agent_session_search" model="ir.ui.view">
        <field name="name">npei.agent.session.search</field>
        <field name="model">npei.agent.session</field>
        <field name="arch" type="xml">
            <search string="Agent Sessions">
                <field name="session_id"/>
                <field name="name"/>
                <field name="create_uid"/>
                <field name="user_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Creator" name="group_creator" context="{'group_by': 'create_uid'}"/>
                    <filter string="Preset" name="group_preset" context="{'group_by': 'preset_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_npei_agent_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">npei.agent.session</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_npei_agent_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a harness session mapping</p>
            <p>Map a harness session id to the Odoo users allowed to drive it.</p>
        </field>
    </record>
    <!-- Server action so the sync can run from a menu when the list is empty. -->
    <record id="action_npei_sync_sessions" model="ir.actions.server">
        <field name="name">Sync Sessions from Harness</field>
        <field name="model_id" ref="model_npei_agent_session"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>
</odoo>
