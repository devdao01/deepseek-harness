<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_provider_tree" model="ir.ui.view">
        <field name="name">npei.agent.provider.tree</field>
        <field name="model">npei.agent.provider</field>
        <field name="arch" type="xml">
            <tree string="Providers">
                <field name="seq" widget='handle'/>
                <field name="seq" optional="show"/>
                <field name="id" optional="show"/>
                <field name="provider"/>
                <field name="display_name"/>
                <field name="settings_ns"/>
                <field name="route_active"/>
                <field name="declared"/>
                <field name="uuid" optional="show"/>
                <field name="is_locked" optional="show"/>
                <field name="active" optional="show"/>
                <field name="create_uid" optional="show"/>
                <field name="write_uid" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="write_date" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_provider_form" model="ir.ui.view">
        <field name="name">npei.agent.provider.form</field>
        <field name="model">npei.agent.provider</field>
        <field name="arch" type="xml">
            <form string="Provider">
                <header>
                    <button name="action_sync_from_harness" type="object"
                            string="Sync from Harness" class="btn-primary"/>
                    <button name="action_sync_models" type="object"
                            string="Sync Models from Harness"
                            groups="npei_agent_harness.group_npei_agent_manager"/>
                    <button name="act_lock" string="Khóa" type="object" groups="npei_base.npei_group_lock" invisible="is_locked"/>
                    <button name="act_unlock" string="Mở Khóa" type="object" groups="npei_base.npei_group_lock" invisible="not is_locked"/>
                </header>
                <sheet>
                    <div class="alert alert-success text-center o_form_header" role="alert" invisible="not is_locked"><div><strong>ĐÃ KHOÁ</strong></div></div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_catalog_models" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="catalog_model_count" widget="statinfo"
                                   string="Catalog Models"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="provider" readonly="1"/>
                            <field name="display_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="settings_ns" readonly="1"/>
                            <field name="settings_id" readonly="1"/>
                            <field name="settings_path" readonly="1"/>
                            <field name="route_active" readonly="1"/>
                            <field name="declared" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Catalog Models" name="catalog_models">
                            <p class="text-muted" colspan="2">Read-only resolved models this provider offers (from llm.models). Run "Sync Models from Harness" to refresh. This is what the provider serves when Configured Models below is empty (inherited).</p>
                            <field name="catalog_model_ids" readonly="1">
                                <tree>
                                    <field name="model_id"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Configured Models (override)" name="models">
                            <field name="model_ids"
                                   groups="npei_agent_harness.group_npei_agent_manager">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="model_id"/>
                                    <field name="name"/>
                                    <field name="context_window"/>
                                    <field name="max_tokens"/>
                                    <field name="seq" optional="hide"/>
                                    <field name="uuid" optional="hide"/>
                                    <field name="is_locked" optional="hide"/>
                                    <field name="active" optional="hide"/>
                                </tree>
                            </field>
                            <p class="text-muted" colspan="2">Optional overrides pushed to the provider's settings namespace as its models array. Leave empty to use the inherited catalog above; emptying it returns to that catalog.</p>
                        </page>
                        <page string="Quản lý Hệ thống*">
                            <notebook>
                                <page string="Cấu hình Hệ thống*">
                                    <notebook>
                                        <page string="Khởi tạo*">
                                            <group>
                                                <group>
                                                    <field name="create_uid" string="Người dùng Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_uid" string="Người dùng Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                    <field name="create_date" string="Thời gian Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_date" string="Thời gian Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="active" widget="boolean_toggle" readonly="is_locked"/>
                                                    <field name="is_locked" readonly="1"/>
                                                    <field name="id" readonly="1"/>
                                                    <field name="uuid" readonly="is_locked"/>
                                                    <field name="seq" readonly="is_locked"/>
                                                </group>
                                            </group>
                                        </page>
                                    </notebook>
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_npei_agent_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">npei.agent.provider</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Server action so the sync can run from a menu when the list is empty. -->
    <record id="action_npei_sync_providers" model="ir.actions.server">
        <field name="name">Sync Providers from Harness</field>
        <field name="model_id" ref="model_npei_agent_provider"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>

    <!-- Sync every provider's configurable models from the harness. -->
    <record id="action_npei_sync_provider_models" model="ir.actions.server">
        <field name="name">Sync Provider Models from Harness</field>
        <field name="model_id" ref="model_npei_agent_provider_model"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>
</odoo>
