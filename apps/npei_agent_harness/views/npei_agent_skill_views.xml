<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_skill_tree" model="ir.ui.view">
        <field name="name">npei.agent.skill.tree</field>
        <field name="model">npei.agent.skill</field>
        <field name="arch" type="xml">
            <tree string="Agent Skills">
                <field name="skill_key"/>
                <field name="name"/>
                <field name="source"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_skill_form" model="ir.ui.view">
        <field name="name">npei.agent.skill.form</field>
        <field name="model">npei.agent.skill</field>
        <field name="arch" type="xml">
            <form string="Agent Skill">
                <header>
                    <button name="action_sync_from_harness" type="object"
                            string="Sync from Harness" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="skill_key"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_npei_agent_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">npei.agent.skill</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Server action so the sync can run from a menu when the list is empty. -->
    <record id="action_npei_sync_skills" model="ir.actions.server">
        <field name="name">Sync Skills from Harness</field>
        <field name="model_id" ref="model_npei_agent_skill"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>
</odoo>
