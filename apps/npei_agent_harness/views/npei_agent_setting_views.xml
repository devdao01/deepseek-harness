<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_setting_tree" model="ir.ui.view">
        <field name="name">npei.agent.setting.tree</field>
        <field name="model">npei.agent.setting</field>
        <field name="arch" type="xml">
            <tree string="Settings Namespaces">
                <field name="seq" widget='handle'/>
                <field name="seq" optional="show"/>
                <field name="id" optional="show"/>
                <field name="ns"/>
                <field name="applies"/>
                <field name="has_document"/>
                <field name="revision"/>
                <field name="uuid" optional="show"/>
                <field name="is_locked" optional="show"/>
                <field name="active" optional="show"/>
                <field name="create_uid" optional="show"/>
                <field name="write_uid" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="write_date" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_setting_form" model="ir.ui.view">
        <field name="name">npei.agent.setting.form</field>
        <field name="model">npei.agent.setting</field>
        <field name="arch" type="xml">
            <form string="Settings Namespace">
                <header>
                    <button name="action_save" type="object"
                            string="Save to Harness" class="btn-primary"/>
                    <button name="action_sync_from_harness" type="object"
                            string="Sync from Harness"/>
                    <button name="act_lock" string="Khóa" type="object" groups="npei_base.npei_group_lock" invisible="is_locked"/>
                    <button name="act_unlock" string="Mở Khóa" type="object" groups="npei_base.npei_group_lock" invisible="not is_locked"/>
                </header>
                <sheet>
                    <div class="alert alert-success text-center o_form_header" role="alert" invisible="not is_locked"><div><strong>ĐÃ KHOÁ</strong></div></div>
                    <group>
                        <group>
                            <field name="ns" readonly="1"/>
                            <field name="applies" readonly="1"/>
                        </group>
                        <group>
                            <field name="has_document" readonly="1"/>
                            <field name="revision" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Providers using this namespace">
                            <field name="provider_ids" nolabel="1" readonly="1">
                                <tree>
                                    <field name="provider"/>
                                    <field name="display_name"/>
                                    <field name="settings_path"/>
                                    <field name="route_active"/>
                                </tree>
                            </field>
                        </page>
                        <page string="User Section (editable)">
                            <field name="user_json" nolabel="1" placeholder="{ }" readonly="is_locked"/>
                        </page>
                        <page string="Resolved Value (read-only)">
                            <field name="value_json" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Quản lý Hệ thống*">
                            <notebook>
                                <page string="Cấu hình Hệ thống*">
                                    <notebook>
                                        <page string="Khởi tạo*">
                                            <group>
                                                <group>
                                                    <field name="create_uid" string="Người dùng Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_uid" string="Người dùng Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                    <field name="create_date" string="Thời gian Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_date" string="Thời gian Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="active" widget="boolean_toggle" readonly="is_locked"/>
                                                    <field name="is_locked" readonly="1"/>
                                                    <field name="id" readonly="1"/>
                                                    <field name="uuid" readonly="is_locked"/>
                                                    <field name="seq" readonly="is_locked"/>
                                                </group>
                                            </group>
                                        </page>
                                    </notebook>
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_npei_agent_setting" model="ir.actions.act_window">
        <field name="name">Harness Settings</field>
        <field name="res_model">npei.agent.setting</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Server action so the sync can run from a menu when the list is empty. -->
    <record id="action_npei_sync_settings" model="ir.actions.server">
        <field name="name">Sync Settings from Harness</field>
        <field name="model_id" ref="model_npei_agent_setting"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>
</odoo>
