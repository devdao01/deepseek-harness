<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_setting_tree" model="ir.ui.view">
        <field name="name">npei.agent.setting.tree</field>
        <field name="model">npei.agent.setting</field>
        <field name="arch" type="xml">
            <tree string="Settings Namespaces">
                <field name="ns"/>
                <field name="applies"/>
                <field name="has_document"/>
                <field name="revision"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_setting_form" model="ir.ui.view">
        <field name="name">npei.agent.setting.form</field>
        <field name="model">npei.agent.setting</field>
        <field name="arch" type="xml">
            <form string="Settings Namespace">
                <header>
                    <button name="action_save" type="object"
                            string="Save to Harness" class="btn-primary"/>
                    <button name="action_sync_from_harness" type="object"
                            string="Sync from Harness"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ns" readonly="1"/>
                            <field name="applies" readonly="1"/>
                        </group>
                        <group>
                            <field name="has_document" readonly="1"/>
                            <field name="revision" readonly="1"/>
                        </group>
                    </group>
                    <group string="User Section (editable)">
                        <field name="user_json" nolabel="1"
                               placeholder="{ }"/>
                    </group>
                    <group string="Resolved Value (read-only)">
                        <field name="value_json" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_npei_agent_setting" model="ir.actions.act_window">
        <field name="name">Harness Settings</field>
        <field name="res_model">npei.agent.setting</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Server action so the sync can run from a menu when the list is empty. -->
    <record id="action_npei_sync_settings" model="ir.actions.server">
        <field name="name">Sync Settings from Harness</field>
        <field name="model_id" ref="model_npei_agent_setting"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>
</odoo>
