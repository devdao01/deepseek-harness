<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_route_template_tree" model="ir.ui.view">
        <field name="name">npei.agent.provider.route.template.tree</field>
        <field name="model">npei.agent.provider.route.template</field>
        <field name="arch" type="xml">
            <tree string="Provider Route Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="route_key"/>
                <field name="api_protocol"/>
                <field name="base_url"/>
                <field name="thinking_format"/>
                <field name="seq" optional="show"/>
                <field name="id" optional="show"/>
                <field name="uuid" optional="show"/>
                <field name="is_locked" optional="show"/>
                <field name="active" optional="show"/>
                <field name="create_uid" optional="show"/>
                <field name="write_uid" optional="show"/>
                <field name="create_date" optional="show"/>
                <field name="write_date" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_route_template_form" model="ir.ui.view">
        <field name="name">npei.agent.provider.route.template.form</field>
        <field name="model">npei.agent.provider.route.template</field>
        <field name="arch" type="xml">
            <form string="Provider Route Template">
                <header>
                    <button name="act_lock" string="Khóa" type="object" groups="npei_base.npei_group_lock" invisible="is_locked"/>
                    <button name="act_unlock" string="Mở Khóa" type="object" groups="npei_base.npei_group_lock" invisible="not is_locked"/>
                </header>
                <sheet>
                    <div class="alert alert-success text-center o_form_header" role="alert" invisible="not is_locked"><div><strong>ĐÃ KHOÁ</strong></div></div>
                    <group>
                        <group>
                            <field name="name" readonly="is_locked"/>
                            <field name="route_key" readonly="is_locked"/>
                            <field name="api_protocol" readonly="is_locked"/>
                        </group>
                        <group>
                            <field name="base_url" readonly="is_locked"/>
                            <field name="thinking_format" readonly="is_locked"/>
                            <field name="active" readonly="is_locked"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" readonly="is_locked"/>
                    </group>
                    <notebook>
                        <page string="Quản lý Hệ thống*">
                            <notebook>
                                <page string="Cấu hình Hệ thống*">
                                    <notebook>
                                        <page string="Khởi tạo*">
                                            <group>
                                                <group>
                                                    <field name="create_uid" string="Người dùng Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_uid" string="Người dùng Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                    <field name="create_date" string="Thời gian Khởi tạo Dữ liệu*:" readonly="1"/>
                                                    <field name="write_date" string="Thời gian Cập nhật Dữ liệu Lần cuối*:" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="active" widget="boolean_toggle" readonly="is_locked"/>
                                                    <field name="is_locked" readonly="1"/>
                                                    <field name="id" readonly="1"/>
                                                    <field name="uuid" readonly="is_locked"/>
                                                    <field name="seq" readonly="is_locked"/>
                                                </group>
                                            </group>
                                        </page>
                                    </notebook>
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_npei_route_template" model="ir.actions.act_window">
        <field name="name">Provider Route Templates</field>
        <field name="res_model">npei.agent.provider.route.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
