<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npei_agent_preset_tree" model="ir.ui.view">
        <field name="name">npei.agent.preset.tree</field>
        <field name="model">npei.agent.preset</field>
        <field name="arch" type="xml">
            <tree string="Agent Presets">
                <field name="preset_id"/>
                <field name="name"/>
                <field name="trust"/>
                <field name="workspace_path"/>
            </tree>
        </field>
    </record>

    <record id="view_npei_agent_preset_form" model="ir.ui.view">
        <field name="name">npei.agent.preset.form</field>
        <field name="model">npei.agent.preset</field>
        <field name="arch" type="xml">
            <form string="Agent Preset">
                <header>
                    <button name="action_sync_from_harness" type="object"
                            string="Sync from Harness" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Hồ Sơ X"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Shown in the preset picker; pushed to the harness on save"/>
                    </group>
                    <group string="Technical" col="2">
                        <!-- All auto: preset_id is derived from the name and the
                             workspace is provisioned by the harness on save;
                             trust is always 'user' for an Odoo-authored copy. -->
                        <field name="preset_id" readonly="1"
                               placeholder="Derived from the name on save"/>
                        <field name="workspace_path" readonly="1"/>
                        <field name="trust" readonly="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_npei_agent_preset" model="ir.actions.act_window">
        <field name="name">Presets</field>
        <field name="res_model">npei.agent.preset</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Server action so the sync can run from a menu when the list is empty. -->
    <record id="action_npei_sync_presets" model="ir.actions.server">
        <field name="name">Sync Presets from Harness</field>
        <field name="model_id" ref="model_npei_agent_preset"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_from_harness()</field>
    </record>
</odoo>
